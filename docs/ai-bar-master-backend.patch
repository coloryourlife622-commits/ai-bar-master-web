+// Minimal structural D1 interfaces; compatible with Cloudflare's native binding.
+export interface Statement {
+  bind(...values: (string | number | null)[]): Statement;
+  first<T>(): Promise<T | null>;
+  all<T>(): Promise<{ results: T[] }>;
+  run(): Promise<unknown>;
+}
+export interface Database {
+  prepare(sql: string): Statement;
+}
+export interface ChatContext {
+  request: Request;
+  env: { DB?: Database; OPENAI_API_KEY?: string };
+  // Set ONLY by middleware after verifying a session. Never copy body/header IDs here.
+  data?: { userId?: string };
+}
